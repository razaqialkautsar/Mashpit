# Public config for the dashboard. Next.js only exposes variables prefixed
# with NEXT_PUBLIC_ to the browser (the spec's VITE_* names are for Vite).
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_ID=contract.mashpit.testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_EXPLORER_URL=https://testnet.nearblocks.io
