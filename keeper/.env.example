# Copy to .env (or set as Railway variables). Never commit real values.

# Keeper account and its FUNCTION-CALL key (restricted to the Mashpit contract).
# Do not use a full-access key here.
KEEPER_ACCOUNT_ID=k1.mashpit.testnet
KEEPER_PRIVATE_KEY=ed25519:...

# Secret used to derive commit salts. Keep it stable across restarts and redeploys,
# otherwise the keeper cannot reveal a bid it committed before the restart.
KEEPER_SECRET=change-me-to-a-long-random-string

# aggressive | balanced | conservative
KEEPER_STRATEGY=balanced

# Demo switch: keep bidding but never execute, so the contract slashes this keeper.
KEEPER_SKIP_EXECUTE=false

# Drain mode: finish pending reveals and executions but never bid in a new round.
# Turn it on (and wait one round) before stopping or redeploying a keeper.
KEEPER_DRAIN=false
# Comma-separated job ids to stop bidding on (pending reveals and executions still finish).
KEEPER_DRAIN_JOBS=

# Gas money. Below LOW the keeper withdraws its earned rewards; below CRITICAL (with no rewards
# left) it stops committing new bids until the account is topped up.
LOW_BALANCE_NEAR=0.1
CRITICAL_BALANCE_NEAR=0.03
MIN_WITHDRAW_NEAR=0.01

CONTRACT_ID=contract.mashpit.testnet
NEAR_NETWORK=testnet
# Tried in order; a failing or rate-limited endpoint moves the keeper to the next one.
RPC_URLS=https://test.rpc.fastnear.com,https://near-testnet.drpc.org,https://testnet-rpc.intea.rs,https://api.zan.top/near-testnet
POLL_MS=3000
# Longest random wait before executing in an open round, so keepers don't all fire at once.
OPEN_JITTER_MS=4000
# Poll interval while every job is idle (e.g. waiting for the next epoch).
IDLE_POLL_MS=20000

# NEAR AI Cloud (optional). Without a key and model the keeper uses the deterministic rule.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_TIMEOUT_MS=15000
# Reuse the last AI decision for a job while the market is unchanged, up to this age (ms).
AI_CACHE_MS=1800000

# Cost model (Tgas burnt per step). Defaults measured on testnet; see src/fallback.ts.
# EST_COMMIT_TGAS=3
# EST_REVEAL_TGAS=3
# EST_EXECUTE_TGAS=20
